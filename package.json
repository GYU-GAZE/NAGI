    "demo": "node scripts/demo-server.mjs",
    "format": "prettier --write src tests demo scripts"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.12",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "jsdom": "^26.1.0",
    "prettier": "3.6.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
